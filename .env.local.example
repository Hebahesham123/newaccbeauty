# Copy this file to .env.local and fill in values from your Supabase project
# (Supabase Dashboard -> Project Settings -> API)

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Only used by scripts/seed.mjs (server-side). NEVER expose this in the browser.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# ---- Embedding this app inside another admin (optional) --------------------
# Origins allowed to load this app in an <iframe> (space separated).
# Example: FRAME_ANCESTORS='self' https://admin.example.com
FRAME_ANCESTORS='self'
# Set to "true" only when embedding cross-site, so auth cookies use
# SameSite=None; Secure. Leave unset/false for standalone use.
NEXT_PUBLIC_EMBED=false
